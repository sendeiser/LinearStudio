# ==============================================================================
# LinearStudio Environment Variables
# ==============================================================================
# Para desarrollo local: copia este archivo como .env.local
# Para Netlify: configúralas en Site Settings > Environment Variables
# ==============================================================================

# [OBLIGATORIA] URL de tu proyecto en Supabase Cloud
VITE_SUPABASE_URL=https://your-project.supabase.co

# [OBLIGATORIA] Llave pública 'anon' de Supabase (segura para exponer en el cliente)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# [OPCIONAL] Token de GitHub por defecto (Personal Access Token con scope 'repo')
# Nota: Los usuarios también pueden vincular su token directamente desde la interfaz en "Configuración & Auth".
VITE_GITHUB_TOKEN=
